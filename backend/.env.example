# GeoMate Android Backend — Environment Configuration
# Copy to .env and adjust as needed

# --- App ---
APP_NAME=GeoMate
APP_VERSION=1.0.1
DEBUG=false
SECRET_KEY=change-me-to-a-random-string

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# --- Database ---
# SQLite: works on Android via Chaquopy
DATABASE_URL=sqlite+aiosqlite:///./data/geomate.db

# --- Vector Store (Android-compatible, replaces ChromaDB) ---
LIGHT_VECTOR_DB_PATH=./data/vectors.db

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu

# --- Anthropic ---
ANTHROPIC_API_KEY=your-api-key-here

# --- Upload ---
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./data/uploads

# --- Server (embedded) ---
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
